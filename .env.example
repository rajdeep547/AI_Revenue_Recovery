RAZORPAY_WEBHOOK_SECRET=your_test_mode_webhook_secret_here
WEBHOOK_DB_PATH=webhook_events.db

# Slice 10 - real execution. Default is "fake" (no network).
EXECUTION_MODE=fake
# Must be truthy for EXECUTION_MODE=razorpay_test to construct a real client.
LIVE_EXECUTION_ENABLED=false
# Razorpay TEST-mode credentials (key id MUST start with rzp_test_). .env is
# gitignored; never commit real values.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_mode_key_secret_here
